[Unit]
Description=OpenNEXT GPU capacity telemetry agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aidcbot
Group=aidcbot
EnvironmentFile=/etc/aidcbot/agent.env
ExecStart=/usr/bin/python3 /opt/aidcbot/aidcbot_agent.py
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
